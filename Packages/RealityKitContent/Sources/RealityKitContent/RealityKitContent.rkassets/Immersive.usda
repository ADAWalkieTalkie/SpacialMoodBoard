#usda 1.0
(
    defaultPrim = "Root"
    metersPerUnit = 1
    upAxis = "Y"
)

def Xform "Root"
{
    float3 xformOp:scale = (1, 1, 1)
    uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]

    def "SkyDome" (
        active = true
        references = @SkyDome.usdz@
    )
    {
        float3 xformOp:scale = (0.01, 0.01, 0.01)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]

        over "mtl"
        {
            over "GridMATSG" (
                active = false
            )
            {
                token outputs:mtlx:surface
                token outputs:realitykit:vertex

                over "GridMAT"
                {
                    color3f inputs:diffuseColor = (1, 1, 1) (
                        colorSpace = "srgb_displayp3"
                    )
                }
            }

            over "GroundMATSG"
            {
                token inputs:frame:stPrimvarName = "st" (
                    customData = {
                        dictionary realitykit = {
                            bool hide = 1
                        }
                    }
                )
                token outputs:mtlx:surface
                token outputs:realitykit:vertex

                def Shader "diffuseColor"
                {
                    uniform token info:id = "UsdUVTexture"
                    asset inputs:file = @bg_day_puresky_4k(1).exr@
                    float2 inputs:st.connect = </Root/SkyDome/mtl/GroundMATSG/diffuseColor/TexCoordReader.outputs:result>
                    color3f outputs:rgb

                    def Shader "TexCoordReader"
                    {
                        uniform token info:id = "UsdPrimvarReader_float2"
                        token inputs:varname.connect = </Root/SkyDome/mtl/GroundMATSG.inputs:frame:stPrimvarName>
                        float2 outputs:result
                    }
                }

                over "GroundMAT"
                {
                    color3f inputs:diffuseColor.connect = </Root/SkyDome/mtl/GroundMATSG/diffuseColor.outputs:rgb>
                    color3f inputs:emissiveColor.connect = </Root/SkyDome/mtl/GroundMATSG/emissiveColor.outputs:rgb>
                }

                def Shader "emissiveColor"
                {
                    uniform token info:id = "UsdUVTexture"
                    asset inputs:file = @bg_day_puresky_4k(1).exr@
                    float2 inputs:st.connect = </Root/SkyDome/mtl/GroundMATSG/emissiveColor/TexCoordReader.outputs:result>
                    color3f outputs:rgb

                    def Shader "TexCoordReader"
                    {
                        uniform token info:id = "UsdPrimvarReader_float2"
                        token inputs:varname.connect = </Root/SkyDome/mtl/GroundMATSG.inputs:frame:stPrimvarName>
                        float2 outputs:result
                    }
                }
            }

            over "DomeMATSG"
            {
                token inputs:frame:stPrimvarName = "st" (
                    customData = {
                        dictionary realitykit = {
                            bool hide = 1
                        }
                    }
                )
                token outputs:mtlx:surface
                token outputs:realitykit:vertex

                def Shader "diffuseColor"
                {
                    uniform token info:id = "UsdUVTexture"
                    asset inputs:file = @bg_day_puresky_4k(1).exr@
                    float2 inputs:st.connect = </Root/SkyDome/mtl/DomeMATSG/diffuseColor/TexCoordReader.outputs:result>
                    color3f outputs:rgb

                    def Shader "TexCoordReader"
                    {
                        uniform token info:id = "UsdPrimvarReader_float2"
                        token inputs:varname.connect = </Root/SkyDome/mtl/DomeMATSG.inputs:frame:stPrimvarName>
                        float2 outputs:result
                    }
                }

                over "DomeMAT"
                {
                    color3f inputs:diffuseColor.connect = </Root/SkyDome/mtl/DomeMATSG/diffuseColor.outputs:rgb>
                    color3f inputs:emissiveColor.connect = </Root/SkyDome/mtl/DomeMATSG/emissiveColor.outputs:rgb>
                }

                def Shader "emissiveColor"
                {
                    uniform token info:id = "UsdUVTexture"
                    asset inputs:file = @bg_day_puresky_4k(1).exr@
                    float2 inputs:st.connect = </Root/SkyDome/mtl/DomeMATSG/emissiveColor/TexCoordReader.outputs:result>
                    color3f outputs:rgb

                    def Shader "TexCoordReader"
                    {
                        uniform token info:id = "UsdPrimvarReader_float2"
                        token inputs:varname.connect = </Root/SkyDome/mtl/DomeMATSG.inputs:frame:stPrimvarName>
                        float2 outputs:result
                    }
                }
            }
        }

        over "Grid" (
            active = false
            prepend apiSchemas = ["MaterialBindingAPI"]
        )
        {
            rel material:binding = </Root/SkyDome/mtl/GridMATSG> (
                bindMaterialAs = "weakerThanDescendants"
            )
            float3 xformOp:scale = (2.220446e-16, 2.220446e-16, 2.220446e-16)
            float3 xformOp:translate = (0, 0, 0)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]
        }
    }

    def Cylinder "Cylinder" (
        active = true
        prepend apiSchemas = ["MaterialBindingAPI"]
        customData = {
            float3 rotationEulerHint = (0, -0.00008726646, 0)
        }
    )
    {
        uniform token axis = "Y"
        double height = 0.2
        rel material:binding = </Root/Cylinder/DefaultMaterial>
        double radius = 0.1
        quatf xformOp:orient = (1, 0, -0.00004363323, 0)
        float3 xformOp:scale = (120, 1, 120)
        float3 xformOp:translate = (0, -0.11, 0)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]

        def Material "DefaultMaterial"
        {
            token inputs:frame:stPrimvarName = "st" (
                customData = {
                    dictionary realitykit = {
                        bool hide = 1
                    }
                }
            )
            token outputs:mtlx:surface
            token outputs:realitykit:vertex
            prepend token outputs:surface.connect = </Root/Cylinder/DefaultMaterial/DefaultSurfaceShader.outputs:surface>

            def Shader "DefaultSurfaceShader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.007988282, 0.001295962, 0.0072094086) (
                    colorSpace = "srgb_displayp3"
                )
                color3f inputs:emissiveColor = (0, 0, 0)
                float inputs:opacity = 0
                float inputs:roughness = 0
                token outputs:surface
            }

            def Shader "diffuseColor"
            {
                uniform token info:id = "UsdUVTexture"
                asset inputs:file = @lilienstein_1k.exr@
                float2 inputs:st.connect = </Root/Cylinder/DefaultMaterial/diffuseColor/TexCoordReader.outputs:result>
                color3f outputs:rgb

                def Shader "TexCoordReader"
                {
                    uniform token info:id = "UsdPrimvarReader_float2"
                    token inputs:varname.connect = </Root/Cylinder/DefaultMaterial.inputs:frame:stPrimvarName>
                    float2 outputs:result
                }
            }

            def Shader "emissiveColor"
            {
                uniform token info:id = "UsdUVTexture"
                asset inputs:file = @bg_day_puresky_4k.hdr@
                float2 inputs:st.connect = </Root/Cylinder/DefaultMaterial/emissiveColor/TexCoordReader.outputs:result>
                color3f outputs:rgb

                def Shader "TexCoordReader"
                {
                    uniform token info:id = "UsdPrimvarReader_float2"
                    token inputs:varname.connect = </Root/Cylinder/DefaultMaterial.inputs:frame:stPrimvarName>
                    float2 outputs:result
                }
            }
        }
    }

    def Xform "DirectionalLight" (
        customData = {
            float3 rotationEulerHint = (-0.7853981, 1.5707963, 0)
        }
    )
    {
        quatf xformOp:orient = (0.6532815, -0.27059805, 0.6532815, 0.27059805)
        float3 xformOp:scale = (1, 1, 1)
        float3 xformOp:translate = (8, 9, 0)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]

        def RealityKitComponent "DirectionalLight"
        {
            float3 color = (0.9999908, 1, 1)
            token info:id = "RealityKit.DirectionalLight"
            float intensity = 2000

            def RealityKitStruct "Shadow"
            {
            }
        }
    }

    def Xform "DirectionalLight_1" (
        customData = {
            float3 rotationEulerHint = (0.79362553, -1.5707963, 0)
        }
    )
    {
        float2 ui:nodegraph:node:pos = (20, 20)
        int ui:nodegraph:node:stackingOrder = 1
        quatf xformOp:orient = (0.6521629, -0.27328318, -0.6521628, -0.27328312)
        float3 xformOp:scale = (0.9999998, 0.9999998, 0.9999998)
        float3 xformOp:translate = (-8, 9.006286, -0.11516757)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]

        def RealityKitComponent "DirectionalLight"
        {
            float3 color = (0.9999908, 1, 1)
            token info:id = "RealityKit.DirectionalLight"
            float intensity = 2000

            def RealityKitStruct "Shadow"
            {
            }
        }
    }

    def Xform "DirectionalLight_2" (
        customData = {
            float3 rotationEulerHint = (-0.785398, 3.1415927, 0)
        }
    )
    {
        float2 ui:nodegraph:node:pos = (40, 40)
        int ui:nodegraph:node:stackingOrder = 2
        quatf xformOp:orient = (-4.038405e-8, 1.6727622e-8, 0.92387956, 0.3826834)
        float3 xformOp:scale = (0.99999964, 0.9999996, 0.9999996)
        float3 xformOp:translate = (-2.9998808, 13.924794, -11.871272)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]

        def RealityKitComponent "DirectionalLight"
        {
            float3 color = (0.9999908, 1, 1)
            token info:id = "RealityKit.DirectionalLight"
            float intensity = 2000

            def RealityKitStruct "Shadow"
            {
            }
        }
    }

    def Xform "DirectionalLight_3" (
        customData = {
            float3 rotationEulerHint = (-0.78539807, 0, 0)
        }
    )
    {
        float2 ui:nodegraph:node:pos = (60, 60)
        int ui:nodegraph:node:stackingOrder = 3
        quatf xformOp:orient = (0.92387956, -0.3826834, 0, 0)
        float3 xformOp:scale = (0.9999995, 0.9999994, 0.9999994)
        float3 xformOp:translate = (-2.9998665, 13.924829, 12.68079)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]

        def RealityKitComponent "DirectionalLight"
        {
            float3 color = (0.9999908, 1, 1)
            token info:id = "RealityKit.DirectionalLight"
            float intensity = 2000

            def RealityKitStruct "Shadow"
            {
            }
        }
    }
}

